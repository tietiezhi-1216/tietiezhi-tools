{
  "schemaVersion": 2,
  "id": "com.tietiezhi.screenshot",
  "name": "截图",
  "version": "1.5.0",
  "summary": "截图、置顶贴图、箭头与马赛克标注、横纵滚动长截图、录屏与 GIF、本地 OCR 和翻译，以及表格、公式和文档导出。",
  "author": "tietiezhi-1216",
  "repository": "https://github.com/tietiezhi-1216/untitled",
  "minimumHostVersion": "0.9.0",
  "actions": [
    "captureRegion",
    "captureWindow",
    "captureScreen",
    "captureScrolling",
    "captureRecording",
    "pinClipboard",
    "togglePins",
    "captureHistory",
    "captureDelayed",
    "captureAndCopy",
    "captureLastRegion",
    "restorePin",
    "cyclePinGroup",
    "closePins",
    "hideOtherPins",
    "togglePinClickThrough",
    "pinFiles",
    "toggleCaptureHotKeys"
  ],
  "templates": [
    {
      "id": "region",
      "title": "区域截图",
      "action": "captureRegion",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 18,
        "modifiers": 4096,
        "key": "1"
      }
    },
    {
      "id": "window",
      "title": "窗口截图",
      "action": "captureWindow"
    },
    {
      "id": "screen",
      "title": "全屏截图",
      "action": "captureScreen"
    },
    {
      "id": "scroll",
      "title": "滚动长截图",
      "action": "captureScrolling"
    },
    {
      "id": "record",
      "title": "开始或停止录屏",
      "action": "captureRecording"
    },
    {
      "id": "pin",
      "title": "剪贴板贴图",
      "action": "pinClipboard",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 19,
        "modifiers": 4096,
        "key": "2"
      }
    },
    {
      "id": "toggle-pins",
      "title": "隐藏或显示贴图",
      "action": "togglePins"
    },
    {
      "id": "history",
      "title": "打开截图历史",
      "action": "captureHistory"
    },
    {
      "id": "delayed",
      "title": "延时截图",
      "action": "captureDelayed",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 18,
        "modifiers": 2048,
        "key": "1"
      }
    },
    {
      "id": "copy",
      "title": "截图并复制",
      "action": "captureAndCopy",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 18,
        "modifiers": 6144,
        "key": "1"
      }
    },
    {
      "id": "repeat-region",
      "title": "重复上次区域",
      "action": "captureLastRegion"
    },
    {
      "id": "restore-pin",
      "title": "恢复贴图",
      "action": "restorePin",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 20,
        "modifiers": 4096,
        "key": "3"
      }
    },
    {
      "id": "cycle-group",
      "title": "切换贴图组",
      "action": "cyclePinGroup",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 50,
        "modifiers": 4096,
        "key": "`"
      }
    },
    {
      "id": "close-pins",
      "title": "关闭本组贴图",
      "action": "closePins"
    },
    {
      "id": "hide-other-pins",
      "title": "隐藏其他贴图",
      "action": "hideOtherPins"
    },
    {
      "id": "click-through",
      "title": "鼠标穿透",
      "action": "togglePinClickThrough"
    },
    {
      "id": "pin-files",
      "title": "文件贴图",
      "action": "pinFiles"
    },
    {
      "id": "toggle-hotkeys",
      "title": "暂停或恢复截图快捷键",
      "action": "toggleCaptureHotKeys"
    }
  ],
  "ui": {
    "version": 1,
    "icon": "camera.viewfinder",
    "slots": {
      "header.leading": [
        {
          "id": "icon",
          "kind": "component",
          "component": "host.icon"
        },
        {
          "id": "identity",
          "kind": "component",
          "component": "host.identity"
        }
      ],
      "header.trailing": [
        {
          "id": "enabled",
          "kind": "component",
          "component": "host.enabled"
        },
        {
          "id": "more",
          "kind": "component",
          "component": "host.more"
        },
        {
          "id": "info",
          "kind": "component",
          "component": "host.info"
        },
        {
          "id": "preferencesButton",
          "kind": "button",
          "symbol": "gearshape",
          "panel": "preferences",
          "presentation": "sheet"
        }
      ],
      "toolbar.leading": [
        {
          "id": "captureMenu",
          "kind": "menu",
          "title": "截图",
          "symbol": "viewfinder",
          "style": "prominent",
          "items": [
            {
              "id": "region",
              "kind": "button",
              "command": "capture.region"
            },
            {
              "id": "window",
              "kind": "button",
              "command": "capture.window"
            },
            {
              "id": "screen",
              "kind": "button",
              "command": "capture.screen"
            },
            {
              "id": "delay",
              "kind": "button",
              "command": "capture.delayed"
            },
            {
              "id": "copy",
              "kind": "button",
              "command": "capture.copy"
            },
            {
              "id": "repeat",
              "kind": "button",
              "command": "capture.repeatRegion"
            }
          ]
        },
        {
          "id": "scrollMenu",
          "kind": "menu",
          "title": "长截图",
          "symbol": "scroll",
          "items": [
            {
              "id": "vertical",
              "kind": "button",
              "command": "capture.scrollVertical"
            },
            {
              "id": "horizontal",
              "kind": "button",
              "command": "capture.scrollHorizontal"
            }
          ]
        },
        {
          "id": "record",
          "kind": "button",
          "command": "capture.record"
        }
      ],
      "toolbar.trailing": [
        {
          "id": "pinsMenu",
          "kind": "menu",
          "title": "贴图",
          "symbol": "pin",
          "items": [
            {
              "id": "pinMenu.pinClipboard",
              "kind": "button",
              "command": "capture.pinClipboard"
            },
            {
              "id": "pinMenu.restorePin",
              "kind": "button",
              "command": "capture.restorePin"
            },
            {
              "id": "pinMenu.pinFiles",
              "kind": "button",
              "command": "capture.pinFiles"
            },
            {
              "id": "pinMenu.cycleGroup",
              "kind": "button",
              "command": "capture.cycleGroup"
            },
            {
              "id": "pinMenu.togglePins",
              "kind": "button",
              "command": "capture.togglePins"
            },
            {
              "id": "pinMenu.closePins",
              "kind": "button",
              "command": "capture.closePins"
            },
            {
              "id": "pinMenu.hideOtherPins",
              "kind": "button",
              "command": "capture.hideOtherPins"
            },
            {
              "id": "pinMenu.clickThrough",
              "kind": "button",
              "command": "capture.clickThrough"
            }
          ]
        },
        {
          "id": "import",
          "kind": "button",
          "command": "capture.importImage",
          "title": "导入…"
        }
      ],
      "content": [
        {
          "id": "pages",
          "kind": "tabs",
          "panels": [
            "history",
            "pins",
            "shortcuts"
          ]
        }
      ],
      "footer.leading": [
        {
          "id": "status",
          "kind": "component",
          "component": "capture.status"
        }
      ],
      "footer.trailing": [
        {
          "id": "togglePins",
          "kind": "button",
          "command": "capture.togglePins",
          "title": "显示 / 隐藏贴图",
          "style": "plain"
        }
      ],
      "menuBar": [
        {
          "id": "menu.region",
          "kind": "button",
          "command": "capture.region"
        },
        {
          "id": "menu.window",
          "kind": "button",
          "command": "capture.window"
        },
        {
          "id": "menu.screen",
          "kind": "button",
          "command": "capture.screen"
        },
        {
          "id": "menu.vertical",
          "kind": "button",
          "command": "capture.scrollVertical"
        },
        {
          "id": "menu.horizontal",
          "kind": "button",
          "command": "capture.scrollHorizontal"
        },
        {
          "id": "menu.record",
          "kind": "button",
          "command": "capture.record"
        },
        {
          "id": "menu.pin",
          "kind": "button",
          "command": "capture.pinClipboard"
        },
        {
          "id": "menu.togglePins",
          "kind": "button",
          "command": "capture.togglePins"
        },
        {
          "id": "menu.history",
          "kind": "button",
          "command": "capture.history"
        }
      ]
    },
    "panels": [
      {
        "id": "history",
        "title": "历史记录",
        "component": "capture.history"
      },
      {
        "id": "pins",
        "title": "贴图",
        "component": "capture.pins"
      },
      {
        "id": "shortcuts",
        "title": "快捷键",
        "slots": {
          "toolbar.leading": [
            {
              "id": "shortcut.commandHeading",
              "kind": "component",
              "component": "host.commandHeading"
            },
            {
              "id": "shortcut.pause",
              "kind": "button",
              "command": "capture.toggleHotKeys",
              "style": "plain"
            }
          ],
          "toolbar.trailing": [
            {
              "id": "shortcut.restore",
              "kind": "button",
              "command": "host.restoreDefaultCommands",
              "style": "plain"
            },
            {
              "id": "shortcut.addCommand",
              "kind": "component",
              "component": "host.addCommand"
            }
          ],
          "content": [
            {
              "id": "shortcut.commands",
              "kind": "component",
              "component": "host.commands"
            }
          ],
          "footer.leading": [
            {
              "id": "shortcut.commandStatus",
              "kind": "component",
              "component": "host.commandStatus"
            }
          ]
        }
      },
      {
        "id": "preferences",
        "title": "截图设置",
        "component": "capture.preferences",
        "width": 720,
        "height": 600
      }
    ]
  },
  "permissions": [
    {
      "id": "system.screenRecording",
      "reason": "截图、滚动长截图和录屏",
      "optional": false
    },
    {
      "id": "system.accessibility",
      "reason": "长截图的自动滚动",
      "optional": true
    },
    {
      "id": "system.inputMonitoring",
      "reason": "录屏按键显示",
      "optional": true
    },
    {
      "id": "system.camera",
      "reason": "录屏摄像头画中画",
      "optional": true
    },
    {
      "id": "system.microphone",
      "reason": "录屏麦克风旁白",
      "optional": true
    }
  ]
}
