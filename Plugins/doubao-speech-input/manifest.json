{
  "schemaVersion": 2,
  "id": "com.untitled.doubao-speech-input",
  "name": "豆信语音输入",
  "version": "1.1.4",
  "summary": "小胶囊纯波形听写；豆包实时草稿与结束定稿，标点在定稿后修正。实时上屏需自行开启实验选项，微信独立接口尚未接通。",
  "author": "tietiezhi-1216",
  "repository": "https://github.com/tietiezhi-1216/untitled",
  "minimumHostVersion": "0.10.5",
  "actions": [
    "toggleDoubaoDictation",
    "holdDoubaoDictation",
    "cancelDoubaoDictation"
  ],
  "templates": [
    {
      "id": "doubao.toggle",
      "title": "开始或结束听写",
      "action": "toggleDoubaoDictation",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 49,
        "modifiers": 6144,
        "key": "空格"
      }
    },
    {
      "id": "doubao.hold",
      "title": "按住说话",
      "action": "holdDoubaoDictation",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 49,
        "modifiers": 6656,
        "key": "空格"
      }
    },
    {
      "id": "doubao.cancel",
      "title": "取消听写",
      "action": "cancelDoubaoDictation",
      "installByDefault": true,
      "defaultHotKey": {
        "keyCode": 53,
        "modifiers": 6144,
        "key": "⎋"
      }
    }
  ],
  "permissions": [
    {
      "id": "system.microphone",
      "reason": "仅在主动开始听写时采集默认麦克风，并实时发送音频到豆包服务端；连接期间有界暂存开头语音"
    },
    {
      "id": "system.accessibility",
      "reason": "仅在实时输入模式下检查目标输入框、文字及选区，通过正常键盘文字事件写入，并仅替换本次听写范围",
      "optional": true
    }
  ],
  "ui": {
    "version": 1,
    "icon": "waveform.and.mic",
    "slots": {
      "header.leading": [
        {
          "id": "icon",
          "kind": "component",
          "component": "host.icon"
        },
        {
          "id": "identity",
          "kind": "component",
          "component": "host.identity"
        }
      ],
      "header.trailing": [
        {
          "id": "shortcut",
          "kind": "button",
          "symbol": "keyboard",
          "panel": "shortcuts"
        },
        {
          "id": "settings",
          "kind": "button",
          "symbol": "slider.horizontal.3",
          "panel": "preferences"
        },
        {
          "id": "enabled",
          "kind": "component",
          "component": "host.enabled"
        },
        {
          "id": "more",
          "kind": "component",
          "component": "host.more"
        },
        {
          "id": "info",
          "kind": "component",
          "component": "host.info"
        }
      ],
      "content": [
        {
          "id": "dictation",
          "kind": "component",
          "component": "doubao.dictation"
        }
      ],
      "menuBar": [
        {
          "id": "menu.open",
          "kind": "button",
          "command": "host.openPlugin"
        },
        {
          "id": "menu.toggle",
          "kind": "button",
          "command": "doubao.toggle"
        },
        {
          "id": "menu.cancel",
          "kind": "button",
          "command": "doubao.cancel"
        }
      ]
    },
    "panels": [
      {
        "id": "preferences",
        "title": "豆信语音输入设置",
        "width": 620,
        "height": 600,
        "component": "doubao.preferences"
      },
      {
        "id": "shortcuts",
        "title": "听写快捷键",
        "width": 700,
        "height": 520,
        "slots": {
          "toolbar.leading": [
            {
              "id": "shortcut.heading",
              "kind": "component",
              "component": "host.commandHeading"
            }
          ],
          "toolbar.trailing": [
            {
              "id": "shortcut.add",
              "kind": "component",
              "component": "host.addCommand"
            }
          ],
          "content": [
            {
              "id": "shortcut.commands",
              "kind": "component",
              "component": "host.commands"
            }
          ],
          "footer.leading": [
            {
              "id": "shortcut.status",
              "kind": "component",
              "component": "host.commandStatus"
            }
          ]
        }
      }
    ]
  }
}
